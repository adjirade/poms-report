APP_NAME="POMS Report"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=poms_report
DB_USERNAME=postgres
DB_PASSWORD=

# Redis Configuration (Redis Stack)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_DRIVER=redis

# Mail Configuration (Optional for notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@poms-report.local"
MAIL_FROM_NAME="${APP_NAME}"

# Broadcasting (Optional)
BROADCAST_DRIVER=log

# File Storage
FILESYSTEM_DISK=local

# Plant Configuration
PLANT_ID=PKS_01
PLANT_NAME="Pabrik Kelapa Sawit 01"

# Bootstrap user passwords (db:seed). Jika kosong, seeder menggenerate
# password acak dan mencetaknya SEKALI ke console.
ADMIN_INITIAL_PASSWORD=
OPERATOR_INITIAL_PASSWORD=

# HQ Sync Configuration (PRD 2.2 - Hub-and-Spoke)
# Sisi PABRIK (spoke): HQ_SYNC_ENABLED=true, HQ_API_URL mengarah ke endpoint HQ,
# contoh: https://hq.example.com/api/hq  (service menambahkan /sync otomatis)
# Sisi HQ (hub): HQ_API_TOKEN harus sama dengan yang dipakai pabrik.
HQ_SYNC_ENABLED=false
HQ_SYNC_VERIFIED_ONLY=true
HQ_SYNC_BATCH_SIZE=200
HQ_SYNC_TIMEOUT=30
HQ_API_URL=https://hq.example.com/api/hq
HQ_API_TOKEN=

# Validation Rules
VALIDATION_TIME_DISCREPANCY_HOURS=4

# PDF/Excel Export
EXPORT_PAPER_SIZE=a4
EXPORT_PAPER_ORIENTATION=portrait

# Livewire Configuration
LIVEWIRE_ASSET_URL=null

# Trusted Proxies (if behind load balancer)
TRUSTED_PROXIES=

# Timezone
APP_TIMEZONE=Asia/Jakarta

# Demo Data (seed dashboard/chart demo data) — jangan aktifkan di produksi
POMS_SEED_DEMO=false
POMS_DEMO_PASSWORD=demo12345

# HTTPS & Proxy (produksi di belakang reverse proxy TLS)
APP_FORCE_HTTPS=false
# APP_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# CORS untuk API (produksi: daftar origin dipisah koma, mis. https://hq.example.com)
CORS_ALLOWED_ORIGINS=*
