/var/www/poms-report/storage/logs/*.log /var/log/poms-report/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 www-data www-data
    sharedscripts
    postrotate
        if [ -f /var/run/supervisord.pid ]; then
            supervisorctl pid poms-queue-worker:* >/dev/null 2>&1 || true
            supervisorctl pid poms-telegram-poll >/dev/null 2>&1 || true
            supervisorctl pid poms-scheduler >/dev/null 2>&1 || true
        fi
    endscript
}
